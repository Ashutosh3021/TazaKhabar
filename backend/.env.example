# TazaKhabar - environment template.
# Copy to .env (git-ignored) and fill in. Never commit the filled-in file.

# --- Pyronites (PyroCore): tables and file storage --------------------------
PYRONITES_URL=https://pyrocore-backend.onrender.com
PYRONITES_KEY=pyro_live_replace_me
PYRONITES_PROJECT_ID=tazakhabar

# Admin-scoped key. Only needed for provisioning (backend/scripts/pyro_provision.py).
# Do not deploy it and revoke it once the tables exist.
PYRONITES_ADMIN_KEY=pyro_live_replace_me

# --- Session cookie ---------------------------------------------------------
# Any long random string. Signs the httpOnly session cookie.
AUTH_SESSION_SECRET=replace_me_with_a_long_random_string
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

# --- Public URLs ------------------------------------------------------------
# API_PUBLIC_URL is the callback target you register with Google and GitHub.
API_PUBLIC_URL=https://tazakhabar-backend.onrender.com
# FRONTEND_URL is where the browser lands after a sign in.
FRONTEND_URL=https://tazakhabar3021.vercel.app

# --- OAuth sign in (no passwords anywhere) ----------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Web application
#   Authorized redirect URI: {API_PUBLIC_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Authorization callback URL: {API_PUBLIC_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- API behaviour ----------------------------------------------------------
# Exact frontend origin, comma separated. No wildcards.
ALLOWED_ORIGINS=https://tazakhabar3021.vercel.app
# Guards the write endpoints (scrape trigger, CSV load, embedding backfill).
ADMIN_TOKEN=replace_me
LOG_LEVEL=INFO

# --- LLM --------------------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Email (optional, for job match alerts) --------------------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
