# Copy to backend/.env and fill values before running locally or deploying.

# --- Database (required) ---
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./tazakhabar.db
# Production (Supabase transaction pooler — use port 6543, not 5432):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?ssl=require

# --- LLM / API keys ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Supabase (resume storage + optional email) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_EMAIL_FROM=

# --- Email SMTP (optional; used when Supabase email is not configured) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true

# --- CORS (required in production) ---
ALLOWED_ORIGINS=http://localhost:3000,https://tazakhabar.vercel.app,https://*.vercel.app

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Notebook CSV pipeline (disable in production) ---
NOTEBOOK_SYNC_ENABLED=true
NOTEBOOK_SYNC_INTERVAL_SEC=15
TAZA_API_URL=http://localhost:8000

# --- Frontend (set in Vercel, not in backend/.env) ---
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
