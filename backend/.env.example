# Environment (development/production)
ENV=development

# Database URL — must use an async driver (aiosqlite / asyncpg / psycopg async).
# Default: SQLite for local dev.
# Postgres / Supabase: use postgresql+asyncpg:// (bare postgresql:// is auto-upgraded).
# Example: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./tazakhabar.db

# App secret for signing cookies/tokens. Replace in production with a secure random value
SECRET_KEY=replace_with_a_random_secret

# LLM / API keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase (if used)
SUPABASE_URL=
SUPABASE_KEY=

# Optional Redis (for caching, rate-limits, job queues)
REDIS_URL=redis://localhost:6379/0

# Embeddings settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://tazakhabar.vercel.app,https://*.vercel.app

# Logging and public API base
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional observability
SENTRY_DSN=

# Notebook CSV pipeline (job_scraper.ipynb → NoteBooks/jobs_output.csv)
NOTEBOOK_SYNC_ENABLED=true
NOTEBOOK_SYNC_INTERVAL_SEC=15
TAZA_API_URL=http://localhost:8000

# Notes:
# - Copy this file to .env and fill secret/API values before running the app.
# - Run backend before Jupyter; CSV sync runs on startup and every NOTEBOOK_SYNC_INTERVAL_SEC.
# - In notebooks: `from push_to_app import sync_jobs_to_app; sync_jobs_to_app()` after saving CSV.
# - scrapper.ipynb → company_data.csv → job_scraper.ipynb → jobs_output.csv → auto-loaded to DB.
# - tazakhabar_scraper.ipynb: use src.db with this DATABASE_URL, or POST /api/notebooks/sync-hn.